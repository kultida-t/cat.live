// โครงฐานข้อมูล Phase 0 — ตารางที่ Auth ใช้ (ตาม docs/data-schema.md)
// ฟิลด์ลับ (เบอร์) แยกไว้ user_private เพื่อไม่ให้หลุดไปกับข้อมูลสาธารณะ

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  displayName      String    @map("display_name")
  method           String
  birthYear        Int?      @map("birth_year")
  guardianConsent  Boolean   @default(false) @map("guardian_consent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  private          UserPrivate?
  pin              PinCredential?
  refreshTokens    RefreshToken[]

  @@map("users")
}

model UserPrivate {
  userId  String @id @map("user_id") @db.Uuid
  phone   String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_private")
}

model PinCredential {
  userId         String    @id @map("user_id") @db.Uuid
  pinHash        String    @map("pin_hash")
  salt           String
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pin_credentials")
}

model OtpChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  refCode           String    @unique @map("ref_code")
  phone             String
  codeHash          String    @map("code_hash")
  salt              String
  attemptsUsed      Int       @default(0) @map("attempts_used")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  resendAvailableAt DateTime  @map("resend_available_at") @db.Timestamptz
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorId, createdAt])
  @@map("audit_logs")
}
